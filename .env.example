# Optional: override the public Monad mainnet RPC.
MONAD_RPC_URL=https://rpc.monad.xyz
PORT=3000
# Must exactly match the address you open in your browser.
APP_ORIGIN=http://localhost:3000
# Optional: persistent SQLite file. Defaults to data/chogchemy.sqlite.
# DATABASE_PATH=C:/path/to/chogchemy.sqlite

# Server-only credentials. Choose orbio or openai. Never commit .env.
IMAGE_PROVIDER=orbio
ORBIO_API_KEY=
ORBIO_IMAGE_MODEL=openai/gpt-image-2
ORBIO_IMAGE_QUALITY=medium
# Optional alternative: set IMAGE_PROVIDER=openai to use these instead.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Provider attempts per UTC day; failures after dispatch also count.
GENERATION_DAILY_LIMIT=10
GENERATION_HOLDER_DAILY_LIMIT=2
